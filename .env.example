# ─── LLM Configuration ──────────────────────────────────────────────────────
# Any OpenAI-compatible API works (Groq, OpenAI, etc.)
# Get a Groq API key at: https://console.groq.com/keys

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ─── Hindsight Memory Configuration ─────────────────────────────────────────
# Hindsight by Vectorize — persistent memory for AI agents
# Docs: https://hindsight.vectorize.io/
# GitHub: https://github.com/vectorize-io/hindsight
# Sign up for Hindsight Cloud: https://ui.hindsight.vectorize.io/signup

HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recallops-incident-memory

# ─── Supabase (auto-configured) ─────────────────────────────────────────────
# These are pre-populated in the Bolt environment.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
